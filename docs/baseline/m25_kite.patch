+
+struct KiteRun {
+    won: bool,
+    secs: f32,
+    kills: u32,
+    levels: Vec<u32>,
+    evolutions: Vec<f32>,
+    boss_time: Option<f32>,
+    alive7: Option<u32>,
+    surge_peak: u32,
+    ults: u32,
+    lamps: u32,
+    damage: Vec<(Source, f64)>,
+}
+
+fn meta_setup(setup: &mut RunSetup, tier: &str) {
+    let initial = ["wind_wheel", "pillar", "longevity", "ice_soul"];
+    setup.charm_pool = initial.iter().map(|s| s.to_string()).collect();
+    let set = |v: &[(&str, u32)]| v.iter().map(|&(k, n)| (k.to_string(), n)).collect::<std::collections::BTreeMap<_, _>>();
+    match tier {
+        "none" => {}
+        "half" => {
+            setup.attributes = set(&[("damage", 5), ("health", 5), ("armor", 2), ("speed", 2), ("magnet", 3), ("crit", 2), ("cooldown", 2), ("xp", 3)]);
+            setup.meta = set(&[("luck", 3), ("seal", 1), ("wick", 2), ("afterglow", 1), ("ember", 1), ("oil", 1)]);
+            setup.charms = vec!["longevity".into()];
+            setup.charm_pool.extend(["night_pearl", "elixir", "five_coins"].iter().map(|s| s.to_string()));
+        }
+        _ => {
+            setup.attributes = set(&[("damage", 10), ("health", 10), ("armor", 5), ("speed", 5), ("magnet", 5), ("crit", 5), ("cooldown", 5), ("xp", 5)]);
+            setup.meta = set(&[("luck", 5), ("seal", 3), ("wick", 3), ("afterglow", 2), ("ember", 3), ("slot", 1), ("oil", 3)]);
+            setup.charms = vec!["longevity".into()];
+            setup.charm_pool.extend(["night_pearl", "elixir", "five_coins", "broken_sword"].iter().map(|s| s.to_string()));
+        }
+    }
+}
+
+fn kite_one(content: &Content, seed: u64, tier: u8, meta: &str, lamp: Option<&str>) -> KiteRun {
+    let mut setup = RunSetup::new(seed, RunMode::Normal);
+    setup.tier = tier;
+    setup.lamp = lamp.map(str::to_string);
+    meta_setup(&mut setup, meta);
+    let mut sim = SimHarness::with_setup(content.clone(), setup);
+    let mut k = kite::Kite::default();
+    let (mut levels, mut evolutions, mut alive7, mut surge_peak, mut ults) = (Vec::new(), Vec::new(), None, 0u32, 0u32);
+    let hz = u64::from(TICK_HZ);
+    while !sim.is_over() && sim.tick() < 15 * 60 * hz {
+        let tick = sim.tick();
+        let (input, cmds) = if sim.phase() == SimPhase::Play { kite::decide(&mut sim, &mut k) } else { (InputFrame::quantize(Vec2::ZERO), Vec::new()) };
+        bot::step(&mut sim, input, &cmds);
+        let t = sim.tick();
+        if t != tick {
+            if t.is_multiple_of(30 * hz) {
+                levels.push(sim.progress().level);
+            }
+            let alive = || { let e = sim.enemies(); (0..e.count).filter(|&i| e.alive[i]).count() as u32 };
+            if t == 420 * hz {
+                alive7 = Some(alive());
+            }
+            if (480 * hz..=515 * hz).contains(&t) && t.is_multiple_of(hz / 4) {
+                surge_peak = surge_peak.max(alive());
+            }
+        }
+        for ev in sim.take_events() {
+            match ev {
+                SimEvent::Evolve { .. } => evolutions.push(sim.tick() as f32 / TICK_HZ as f32),
+                SimEvent::Ult if sim.tick() < 570 * u64::from(TICK_HZ) => ults += 1,
+                _ => {}
+            }
+        }
+    }
+    let won = sim.flow().result.as_ref().is_some_and(|r| r.won);
+    let secs = sim.tick() as f32 / TICK_HZ as f32;
+    let since = sim.world().resource::<lantern_sim::run::Director>().boss_since;
+    let lamps = sim.world().resource::<lantern_sim::lanterns::Lanterns>().0.iter().filter(|l| l.lit).count() as u32;
+    KiteRun {
+        won,
+        secs,
+        kills: sim.progress().kills,
+        levels,
+        evolutions,
+        boss_time: won.then_some(secs - since),
+        alive7,
+        surge_peak,
+        ults,
+        lamps,
+        damage: sim.damage_log().0.clone(),
+    }
+}
+
+fn kite_cmd(args: &[String]) -> Result<(), String> {
+    let runs = flag(args, "--runs", 40)?;
+    let seed0 = flag(args, "--seed", 1)?;
+    let tier = flag(args, "--tier", 1)? as u8;
+    let meta = args.iter().position(|a| a == "--meta").and_then(|i| args.get(i + 1)).map_or("none", String::as_str).to_string();
+    let lamp = args.iter().position(|a| a == "--lamp").and_then(|i| args.get(i + 1)).cloned();
+    let content = Content::load(&data_dir()).map_err(|e| e.to_string())?;
+    let start = Instant::now();
+    let all: Vec<KiteRun> = (0..runs).map(|k| kite_one(&content, seed0 + k, tier, &meta, lamp.as_deref())).collect();
+    let n = runs as f32;
+    let wins = all.iter().filter(|r| r.won).count();
+    let early = all.iter().filter(|r| !r.won && r.secs < 180.0).count();
+    let mmss = |s: f32| format!("{}:{:02}", (s / 60.0) as u32, (s % 60.0) as u32);
+    println!("风筝机器人 {runs} 局，{tier} 更，局外成长 {meta}，灯 {}，用时 {:.1} 秒", lamp.as_deref().unwrap_or("默认"), start.elapsed().as_secs_f64());
+    println!("胜率 {:.0}%；3 分钟前倒下 {:.0}%；存活中位 {}；击杀中位 {:.0}", 100.0 * wins as f32 / n, 100.0 * early as f32 / n,
+        mmss(median(all.iter().map(|r| r.secs).collect())), median(all.iter().map(|r| r.kills as f32).collect()));
+    let lv = |i: usize| { let v: Vec<f32> = all.iter().filter_map(|r| r.levels.get(i).map(|&l| l as f32)).collect(); (median(v.clone()), v.len()) };
+    let (l3, n3) = lv(5);
+    let (l6, n6) = lv(11);
+    let (l9, n9) = lv(17);
+    println!("等级中位（活着的局）：3 分 {l3:.0}（{n3} 局），6 分 {l6:.0}（{n6} 局），9 分 {l9:.0}（{n9} 局）");
+    let evo: Vec<f32> = all.iter().filter_map(|r| r.evolutions.first().copied()).collect();
+    let alive_at = |s: f32| all.iter().filter(|r| r.secs >= s).count();
+    println!("第一次进化：活过 6:15 的 {} 局里 {} 局有进化，进化中位 {}", alive_at(375.0), evo.len(), mmss(median(evo)));
+    let bt: Vec<f32> = all.iter().filter_map(|r| r.boss_time).collect();
+    println!("夜主击杀时间中位 {:.0} 秒（{} 局）", median(bt.clone()), bt.len());
+    let a7: Vec<f32> = all.iter().filter_map(|r| r.alive7.map(|a| a as f32)).collect();
+    let sp: Vec<f32> = all.iter().filter(|r| r.secs > 515.0).map(|r| r.surge_peak as f32).collect();
+    println!("7 分钟场上妖物中位 {:.0}；妖潮峰值中位 {:.0}", median(a7), median(sp));
+    let ult_int: Vec<f32> = all.iter().filter(|r| r.ults > 0).map(|r| r.secs.min(570.0) / r.ults as f32).collect();
+    println!("燃灯平均间隔中位 {:.0} 秒；石灯笼平均点亮 {:.1} 盏", median(ult_int), all.iter().map(|r| r.lamps as f32).sum::<f32>() / n);
+    let deaths: Vec<f32> = all.iter().filter(|r| !r.won).map(|r| r.secs).collect();
+    let bucket = |a: f32, b: f32| deaths.iter().filter(|&&s| s >= a && s < b).count();
+    let mut ds = deaths.clone();
+    ds.sort_by(f32::total_cmp);
+    println!("倒下时刻：{}", ds.iter().map(|&d| mmss(d)).collect::<Vec<_>>().join(" "));
+    println!("倒下时间分布：0–3 分 {}，3–5 分 {}，5–8 分 {}，8–9:30 分 {}，夜主战 {}", bucket(0.0, 180.0), bucket(180.0, 300.0), bucket(300.0, 480.0), bucket(480.0, 570.0), bucket(570.0, 2000.0));
+    let mut total: Vec<(Source, f64)> = Vec::new();
+    for r in &all {
+        for &(s, d) in &r.damage {
+            match total.iter_mut().find(|(t, _)| *t == s) {
+                Some((_, v)) => *v += d,
+                None => total.push((s, d)),
+            }
+        }
+    }
+    let sum: f64 = total.iter().map(|(_, d)| d).sum::<f64>().max(1.0);
+    total.sort_by(|a, b| b.1.total_cmp(&a.1));
+    let shares: Vec<String> = total.iter().take(12).map(|&(s, d)| format!("{} {:.1}%", source_name(&content, s), d / sum * 100.0)).collect();
+    println!("伤害来源：{}", shares.join("，"));
+    Ok(())
+}
