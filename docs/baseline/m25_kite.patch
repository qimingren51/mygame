+//! 临时实验：会躲的风筝机器人（玩法与数值会话测平衡用，不提交）。
+//!
+//! 走位：每步在 16 个方向里挑威胁最小的一个。威胁 = 前方几个采样点附近的妖物、弹幕（按速度外推）、
+//! 夜主的扇形和落点预警、结界边缘。安全时去点石灯笼。快被碰到时闪避。
+
+use bevy_math::{Vec2, ops};
+use lantern_sim::boss::{BossState, Foes};
+use lantern_sim::lanterns::Lanterns;
+use lantern_sim::run::Director;
+use lantern_sim::{Health, InputFrame, Player, Pos, SimCommand, SimHarness};
+
+const DIRS: usize = 16;
+const PLAYER_R: f32 = 11.0;
+
+#[derive(Default)]
+pub struct Kite {
+    last: Vec2,
+}
+
+pub fn decide(sim: &mut SimHarness, k: &mut Kite) -> (InputFrame, Vec<SimCommand>) {
+    let (p, dash_ready, hp, hp_max) = {
+        let world = sim.world_mut();
+        let mut q = world.query::<(&Pos, &Player, &Health)>();
+        let Ok((pos, pl, h)) = q.single(world) else {
+            return (InputFrame::quantize(Vec2::ZERO), Vec::new());
+        };
+        (pos.0, pl.dash_ready, h.hp, h.max)
+    };
+    let speed = sim.stats().get(lantern_content::Stat::Speed).max(30.0);
+    let w = sim.world();
+    let en = sim.enemies();
+    let mut near: Vec<(Vec2, f32, f32)> = Vec::new();
+    let mut nearest = f32::MAX;
+    for i in 0..en.count {
+        if !en.alive[i] {
+            continue;
+        }
+        let q = Vec2::new(en.x[i], en.y[i]);
+        let d = q.distance(p);
+        if d < 340.0 {
+            let gap = d - en.r[i] - PLAYER_R;
+            nearest = nearest.min(gap);
+            let wgt = if en.max_hp[i] > 2000.0 {
+                6.0
+            } else if en.max_hp[i] > 150.0 {
+                3.0
+            } else {
+                1.0
+            };
+            near.push((q, en.r[i], wgt));
+        }
+    }
+    let shots: Vec<(Vec2, Vec2, f32)> =
+        w.resource::<Foes>().0.iter().filter(|f| f.pos.distance(p) < 320.0).map(|f| (f.pos, f.vel, f.radius)).collect();
+    let mut bullet_close = false;
+    for &(s, v, r) in &shots {
+        for t in [0.0f32, 0.1, 0.2] {
+            if (s + v * t).distance(p) - r - PLAYER_R < 6.0 {
+                bullet_close = true;
+            }
+        }
+    }
+    let boss = w.resource::<BossState>();
+    let sweeps: Vec<_> = boss.sweeps.clone();
+    let drops: Vec<_> = boss.drops.clone();
+    let barrier = w.resource::<Director>().barrier;
+    let lamps = w.resource::<Lanterns>();
+    let safe = nearest > 90.0 && shots.iter().all(|&(s, _, _)| s.distance(p) > 120.0);
+    let low = hp < hp_max * 0.35;
+    // 最近的一盏没点亮的灯
+    let lamp = lamps
+        .0
+        .iter()
+        .filter(|l| !l.lit)
+        .map(|l| l.pos)
+        .min_by(|a, b| a.distance_squared(p).total_cmp(&b.distance_squared(p)));
+    let in_hazard = |q: Vec2| -> bool {
+        sweeps.iter().any(|sw| {
+            let d = q - sw.origin;
+            let a = ops::atan2(d.y, d.x);
+            let mut diff = a - sw.dir;
+            while diff > std::f32::consts::PI {
+                diff -= std::f32::consts::TAU;
+            }
+            while diff < -std::f32::consts::PI {
+                diff += std::f32::consts::TAU;
+            }
+            d.length() <= sw.radius + PLAYER_R + 10.0 && diff.abs() <= sw.angle * 0.5 + 0.15
+        }) || drops.iter().any(|r| q.distance(r.pos) <= r.radius + PLAYER_R + 10.0)
+    };
+    // 点灯：安全、站在灯旁就不动
+    if let Some(l) = lamp
+        && safe
+        && !low
+        && l.distance(p) < 40.0
+        && !in_hazard(p)
+    {
+        return (InputFrame::quantize(Vec2::ZERO), Vec::new());
+    }
+    let lamp_dir = lamp.filter(|l| l.distance(p) < 1500.0).map(|l| (l - p).normalize_or_zero());
+    let mut best = (f32::MAX, Vec2::X);
+    for j in 0..DIRS {
+        let a = j as f32 / DIRS as f32 * std::f32::consts::TAU;
+        let d = Vec2::new(ops::cos(a), ops::sin(a));
+        let mut threat = 0.0f32;
+        for step in [20.0f32, 48.0, 90.0] {
+            let q = p + d * step;
+            let t = step / speed;
+            let reach = if low { 150.0 } else { 115.0 };
+            for &(e, r, wgt) in &near {
+                let dist = (q.distance(e) - r - PLAYER_R).max(0.0);
+                if dist < reach {
+                    let x = 1.0 - dist / reach;
+                    threat += wgt * x * x * x;
+                }
+            }
+            for &(s, v, r) in &shots {
+                let dist = ((s + v * t).distance(q) - r - PLAYER_R).max(0.0);
+                if dist < 40.0 {
+                    threat += 4.0 * (1.0 - dist / 40.0);
+                }
+            }
+            if in_hazard(q) {
+                threat += 25.0;
+            }
+            if let Some((c, rad)) = barrier {
+                let out = q.distance(c) - (rad - 60.0);
+                if out > 0.0 {
+                    threat += out * 0.15;
+                }
+            }
+        }
+        threat -= 0.25 * d.dot(k.last);
+        if let Some(ld) = lamp_dir {
+            threat -= if safe { 1.2 } else { 0.25 } * d.dot(ld);
+        }
+        if threat < best.0 {
+            best = (threat, d);
+        }
+    }
+    k.last = best.1;
+    let mut cmds = Vec::new();
+    if dash_ready > 0 && (nearest < 3.0 || bullet_close || in_hazard(p)) {
+        cmds.push(SimCommand::Dash);
+    }
+    (InputFrame::quantize(best.1), cmds)
+}
