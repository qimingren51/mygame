     pub fn late_at(&self, q: Quad, slope: f32, m: f32) -> f32 {
         let after = self.late.after;
-        if m <= after { q.at(m) } else { q.at(after) * (1.0 + slope * (m - after)) }
+        if m <= after {
+            return q.at(m);
