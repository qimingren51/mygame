index 46539a5..1984b4d 100644
--- a/crates/content/src/defs.rs
+++ b/crates/content/src/defs.rs
@@ -133,7 +133,16 @@ impl RunDef {
     /// 第 m 分钟的曲线值：after 分钟以前照 q，之后 = after 时的值 × (1 + slope × (m − after))。
     pub fn late_at(&self, q: Quad, slope: f32, m: f32) -> f32 {
         let after = self.late.after;
-        if m <= after { q.at(m) } else { q.at(after) * (1.0 + slope * (m - after)) }
+        if m <= after {
+            return q.at(m);
+        }
+        // 实验：生命按每分钟复利涨
+        if slope == self.late.hp
+            && let Some(g) = std::env::var("LATE_HP_GROWTH").ok().and_then(|v| v.parse::<f32>().ok())
+        {
+            return q.at(after) * g.powf(m - after);
+        }
+        q.at(after) * (1.0 + slope * (m - after))
     }
 }
 
