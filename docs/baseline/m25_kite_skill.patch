+    dash_chance: f32,
+}
+
+impl Skill {
+    fn by_name(name: &str) -> Option<Self> {
+        Some(match name {
+            // 新手：约 0.35 秒反应一次，只盯着身边，不预判弹幕，走位偏差大，常常忘了闪避
