// 灯坠（docs/GAMEPLAY.md 第 5.7 节，名字见 docs/LORE.md 第 9.4 节）：挂在灯上改写规则，每一枚都有代价。
// 出发前挂一枚；局内 5:00 小头目必给一次三选一，精英宝箱 30% 附带一次，货郎 80 铜钱一次。
// 风火轮、定海神针、长命锁、冰魄珠一开始就有，其余靠成就解锁（achievements.ron）。P0 做这 8 枚。
[
    (id: "wind_wheel", name: "风火轮", flavor: "仿哪吒那对风火轮打的，只有巴掌大。踩着闪一步，地上留一道火。", good: "闪避更远，留下火痕", bad: "闪避冷却 +0.4 秒",
     effects: [Mul(DashDistance, 0.4), Add(TrailDamage, 1.5), Add(DashCooldown, 0.4)], initial: true),
    (id: "pillar", name: "定海神针", flavor: "大禹量海那根铁的小样，一拃长，沉得坠手。", good: "站定：攻防各 +25%", bad: "移动时伤害 -10%",
     effects: [Add(StillDamage, 0.25), Add(StillReduction, 0.25), Add(MovingDamage, -0.10)], initial: true),
    (id: "night_pearl", name: "照夜珠", flavor: "头一回点齐五盏石灯笼那夜，灯光收拢，地上多了这颗珠子。", good: "照见圈 +30%，易伤 +8%", bad: "圈外妖物移速 +25%",
     effects: [Mul(Reveal, 0.3), Add(RevealVuln, 0.08), Add(DarkSpeed, 0.25)]),
    (id: "elixir", name: "九转金丹", flavor: "老君炉里炼的，只此一颗。倒下时含着，能再站起来一回。", good: "倒下复活一次", bad: "占一格，用完即碎",
     effects: [Rule(Revive)]),
    (id: "five_coins", name: "五帝钱", flavor: "五个皇帝年间的铜钱，红线串着，民间拿来镇宅。缺一枚就不灵。", good: "每系一阶，伤害 +5%", bad: "每缺一系，伤害 -8%",
     effects: [ByTiers(stat: Damage, on: 0.05, off: -0.08, all: 0.10)]),
    (id: "longevity", name: "长命锁", flavor: "灯童从脖子上摘下来的，说好了回来要还。", good: "生命上限 +60", bad: "伤害 -10%",
     effects: [Add(MaxHp, 60.0), Add(Damage, -0.10)], initial: true),
    (id: "ice_soul", name: "冰魄珠", flavor: "北冥的冰魄碎了，剩下这颗，攥久了手会麻。", good: "冻死的妖，魂火 ×2", bad: "冰冻时长 -20%",
     effects: [Add(FrozenXp, 1.0), Mul(FreezeTime, -0.2)], initial: true),
    (id: "broken_sword", name: "断剑", flavor: "半截剑，断口没有磨平，也配不上鞘。", good: "法器伤害 +35%", bad: "法器栏只剩 4 格",
     effects: [Add(Damage, 0.35), Add(WeaponSlots, -2.0)], max_weapons: Some(4)),
]
