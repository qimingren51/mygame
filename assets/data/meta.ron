// 心灯（docs/GAMEPLAY.md 第 11.3 节，花费见 docs/BALANCE.md 第 10.4 节）：用灯油点亮，只管功能和规则；
// 数值加成在 attributes.ron（铜钱）。第 n 级花费 = round(base_cost × 2^(n−1) / 10) × 10。
// 悟·五行：出发前从已点亮的悟里选一个生效，那一系的升级选项权重 ×1.15。
#![enable(implicit_some)]
(
    // 对应 BALANCE 10.4.1，界面提示下一盏，不作为购买前置。
    intro: [("luck", 1), ("seal", 1), ("ember", 1), ("wu_fire", 1),
            ("afterglow", 1), ("wick", 1), ("wu_wood", 1), ("seal", 2), ("slot", 1)],
    cost_exp: 2.0,
    cost_round: 10.0,
    nodes: [
        (id: "luck", name: "祈福", icon: "祈", desc: "宝箱多开 +3%，加重抽", max_level: 5,
         base_cost: 200.0, per_level: [Add(ChestLuck, 0.03)],
         levels: [[Add(Rerolls, 1.0)], [], [Add(Rerolls, 1.0)], [], [Add(Rerolls, 1.0)]]),
        (id: "seal", name: "封印", icon: "封", desc: "每级封印 +1 次", max_level: 3,
         base_cost: 300.0, per_level: [Add(Banishes, 1.0)]),
        (id: "wick", name: "添油", icon: "添", desc: "燃灯 +8%，照见圈 +4%", max_level: 3,
         base_cost: 200.0, per_level: [Add(UltCharge, 0.08), Mul(Reveal, 0.04)]),
        (id: "afterglow", name: "回光", icon: "回", desc: "濒死留 1 血；2 级回血 30%",
         max_level: 2, base_cost: 600.0, per_level: [Add(LastStand, 1.0)]),
        (id: "ember", name: "余烬", icon: "烬", desc: "开局先选一门心法", max_level: 3,
         base_cost: 400.0, per_level: [Add(StartPassive, 1.0)]),
        (id: "slot", name: "灯坠栏", icon: "栏", desc: "第 4 个灯坠栏", max_level: 1,
         base_cost: 1600.0, per_level: [Add(CharmSlots, 1.0)]),
        (id: "wu_metal", name: "悟·金", icon: "金", desc: "金系选项更常出现", max_level: 1,
         base_cost: 400.0, insight: Metal),
        (id: "wu_wood", name: "悟·木", icon: "木", desc: "木系选项更常出现", max_level: 1,
         base_cost: 400.0, insight: Wood),
        (id: "wu_water", name: "悟·水", icon: "水", desc: "水系选项更常出现", max_level: 1,
         base_cost: 400.0, insight: Water),
        (id: "wu_fire", name: "悟·火", icon: "火", desc: "火系选项更常出现", max_level: 1,
         base_cost: 400.0, insight: Fire),
        (id: "wu_earth", name: "悟·土", icon: "土", desc: "土系选项更常出现", max_level: 1,
         base_cost: 400.0, insight: Earth),
        (id: "oil", name: "香火", icon: "香", desc: "灯油收益 +5%", max_level: 3,
         base_cost: 400.0, per_level: [Mul(OilGain, 0.05)]),
    ],
)
