// 属性的基础值与上下限（docs/DESIGN.md 第 6.6 节，docs/BALANCE.md 第 3.4 节）。
// 最终值 = clamp((基础值 + Σ加值) × (1 + Σ乘值), min, max)。
// 加值、乘值来自心法、五行共鸣、相生、夜签、心灯、古灯增益（写成 Add(属性, 值)、Mul(属性, 值)）。
// M2 照搬网页版：冷却下限 0.6、减伤上限 60%。
{
    // 输出
    Damage: (base: 1.0, min: 0.0),
    Area: (base: 1.0, min: 0.2, max: 3.0),
    Cooldown: (base: 1.0, min: 0.6, max: 3.0),
    Amount: (base: 0.0, min: 0.0, max: 6.0),
    CritChance: (base: 0.05, min: 0.0, max: 1.0),
    CritMult: (base: 2.0, min: 1.0),
    Knockback: (base: 1.0, min: 0.0, max: 4.0),
    BurnDamage: (base: 1.0, min: 0.0),
    BurnStacks: (base: 1.0, min: 1.0, max: 5.0),
    FrozenDamage: (base: 0.0, min: 0.0),
    StunCrit: (base: 0.0, min: 0.0),
    // 生存
    MaxHp: (base: 100.0, min: 1.0),
    Armor: (base: 0.0, min: 0.0, max: 15.0),
    Reduction: (base: 0.0, min: 0.0, max: 0.6),
    // 每秒回复生命上限的比例
    Regen: (base: 0.0, min: 0.0),
    ShieldCooldown: (base: 10.0, min: 1.0),
    // 治疗倍率；0 表示无法回复生命（不掉莲子、不出灵泉）
    Healing: (base: 1.0, min: 0.0),
    // 移动与拾取
    Speed: (base: 118.0, min: 30.0, max: 212.0),
    Magnet: (base: 65.0, min: 10.0, max: 400.0),
    Light: (base: 1.0, min: 0.3, max: 2.5),
    XpGain: (base: 1.0, min: 0.0),
    // 构筑
    Rerolls: (base: 2.0, min: 0.0),
    Choices: (base: 3.0, min: 1.0, max: 4.0),
    ChestMin: (base: 1.0, min: 1.0, max: 5.0),
    ChestLuck: (base: 0.0, min: 0.0),
    // 单局规则
    SpawnRate: (base: 1.0, min: 0.0),
    EnemyHp: (base: 1.0, min: 0.1),
    EnemySpeed: (base: 1.0, min: 0.1),
    EliteCount: (base: 1.0, min: 0.0, max: 4.0),
    EventRate: (base: 1.0, min: 0.1),
    OilGain: (base: 1.0, min: 0.0),
}
