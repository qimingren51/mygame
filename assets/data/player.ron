// 主角（移植自网页版 balance.ts 的 PLAYER）。会成长的数值（移速、生命、拾取、暴击……）在 stats.ron。
// 单位：距离是世界单位（与网页版像素一致），时间是秒。
(
    radius: 11.0,
    hurt_iframe: 0.5,
    start_weapon: "lamp",
    // 闪避：0.16 秒冲刺、0.3 秒无敌；冷却、段数、距离倍率在 stats.ron
    dash: (
        duration: 0.16,
        speed: 720.0,
        iframe: 0.3,
    ),
    // 燃灯（docs/BALANCE.md 第 4.5 节）：按清怪量充能，跟得上刷怪时约 40 秒充满；精英额外 +15%。
    // 充满后对视野内所有妖物造成 120 × (1 + 0.4m) 伤害，对夜主每次不超过最大生命的 2.5%，同时清掉弹幕。
    ult: (
        clear_seconds: 40.0,
        charge_elite: 0.15,
        damage: (120.0, 48.0, 0.0),
        knockback: 160.0,
        boss_fraction: 0.025,
    ),
    // 照见圈（规则半径，基础值和上限在 stats.ron 的 Reveal）每升一级 +1%；灯光（画面）每级 +0.5%。
    // 灯焰带：照见圈最外面 20 宽的一圈，每秒伤害 (4 + 等级) × (1 + 0.25 × (灯芯等级 − 1))，
    // 吃加成区和易伤，不暴击、不打印记（docs/BALANCE.md 第 7.3 节）。
    reveal: (
        per_level: 0.01,
        light_per_level: 0.005,
        band_width: 20.0,
        band_dps: (4.0, 1.0, 0.0),
        band_per_rank: 0.25,
    ),
    // 灯坠的局内机制（docs/GAMEPLAY.md 第 5.7 节）。
    // 风火轮：闪避每走 14 留一段火痕，半径 24、持续 2 秒，每秒伤害 = TrailDamage（1.5）× 最强法器的基础伤害。
    charms: (
        still_after: 1.0,
        trail_gap: 14.0,
        trail_radius: 24.0,
        trail_life: 2.0,
        thorn_freeze: 1.0,
    ),
    // 救命：先回光（心灯），再九转金丹（灯坠）。回光留 1 点生命，2 级再回复 30%；九转金丹回复 50%。
    // 回光震退周围 180 以内，九转金丹震退全屏；之后无敌 2 秒。
    rescue: (
        last_stand_heal: 0.3,
        revive_heal: 0.5,
        radius: 180.0,
        knockback: 520.0,
        iframe: 2.0,
    ),
)
