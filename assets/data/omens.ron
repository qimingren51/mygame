// 夜签（docs/GAMEPLAY.md 第 10.2 节）：开局从中随机抽 3 张，选 1 张。原有 10 张移植自网页版，P0 新增无月、逆克。
// 每张都有好处和代价。pick_element 的夜签抽到时随机选定一种五行，good 里的 {el} 换成它的名字。
[
    (id: "bloodmoon", name: "血月", good: "魂火 +35%", bad: "妖物数量 +35%",
     effects: [Mul(XpGain, 0.35), Mul(SpawnRate, 0.35)]),
    (id: "fog", name: "浓雾", good: "暴击率 +15%", bad: "灯光范围 -30%",
     effects: [Add(CritChance, 0.15), Mul(Light, -0.3)]),
    (id: "glass", name: "琉璃夜", good: "伤害 +40%", bad: "生命上限 -35%",
     effects: [Add(Damage, 0.4), Mul(MaxHp, -0.35)]),
    (id: "foxes", name: "狐火夜", good: "宝箱至少三连", bad: "精英数量翻倍",
     effects: [Add(ChestMin, 2.0), Add(EliteCount, 1.0)]),
    (id: "gale", name: "疾风", good: "移动速度 +25%", bad: "妖物移速 +25%",
     effects: [Mul(Speed, 0.25), Mul(EnemySpeed, 0.25)]),
    (id: "chestrain", name: "灯花", good: "每 100 秒天降宝箱", bad: "妖物血量 +25%",
     effects: [Trigger(on: Periodic(100.0), action: DropChest(distance: 110.0)), Mul(EnemyHp, 0.25)]),
    (id: "element", name: "五星", good: "{el}系开局即得 3 点共鸣", bad: "其他四系选项更少出现",
     pick_element: true, effects: [Points(3), Favor]),
    (id: "greed", name: "贪狼", good: "灯油和铜钱 +50%", bad: "无法回复生命",
     effects: [Mul(OilGain, 0.5), Mul(GoldGain, 0.5), Mul(Healing, -1.0)]),
    (id: "quiet", name: "静夜", good: "妖物数量 -25%", bad: "升级只有两个选项",
     effects: [Mul(SpawnRate, -0.25), Add(Choices, -1.0)]),
    (id: "wonders", name: "奇遇夜", good: "奇遇出现频率翻倍", bad: "妖物血量 +15%",
     effects: [Mul(EventRate, 1.0), Mul(EnemyHp, 0.15)]),
    // M2.5 新增（docs/GAMEPLAY.md 第 10.2 节）
    (id: "wuyue", name: "无月", good: "对圈外妖物伤害 +50%", bad: "圈外完全看不见",
     effects: [Add(DarkDamage, 0.5), Rule(NoMoon)]),
    (id: "nike", name: "逆克", good: "相克反应的伤害翻倍", bad: "相生被动无效",
     effects: [Mul(KeReaction, 1.0), Rule(NoSheng)]),
]
