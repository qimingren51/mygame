// 难度“更”（docs/GAMEPLAY.md 第 12.2 节，docs/BALANCE.md 第 9 节）。规则逐更累加，写成修正效果。
// P0 只做一更到三更。灯油和铜钱的倍率乘在结算上。
[
    (name: "一更", desc: "标准", effects: []),
    (name: "二更", desc: "精英带词缀，妖更硬更痛", effects: [
        Mul(EnemyHp, 0.5), Mul(SpawnRate, 0.1), Mul(EnemyDamage, 0.9), Add(Affixes, 1.0), Mul(BossHp, 0.2),
        Mul(OilGain, 0.25), Mul(GoldGain, 0.25),
    ]),
    (name: "三更", desc: "夜主多一招，回血 -25%", effects: [
        Mul(EnemyHp, 1.2), Mul(SpawnRate, 0.2), Mul(EnemyDamage, 2.1), Add(Affixes, 1.0), Mul(BossHp, 0.4),
        Mul(Healing, -0.25), Rule(BossExtra),
        Mul(OilGain, 0.5), Mul(GoldGain, 0.5),
    ]),
]
