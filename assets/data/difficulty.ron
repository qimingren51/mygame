// 难度“更”（docs/GAMEPLAY.md 第 12.2 节，docs/BALANCE.md 第 9 节）。规则逐更累加，写成修正效果。
// P0 只做一更到三更。灯油和金币的倍率乘在结算上。
[
    (name: "一更", desc: "标准", effects: []),
    (name: "二更", desc: "精英带 1 个词缀；妖物生命 ×1.3", effects: [
        Mul(EnemyHp, 0.3), Mul(SpawnRate, 0.05), Mul(EnemyDamage, 0.1), Add(Affixes, 1.0), Mul(BossHp, 0.3),
        Mul(OilGain, 0.25), Mul(GoldGain, 0.25),
    ]),
    (name: "三更", desc: "夜主多一招；回复 -25%；妖物生命 ×1.7、伤害 ×1.25", effects: [
        Mul(EnemyHp, 0.7), Mul(SpawnRate, 0.1), Mul(EnemyDamage, 0.25), Add(Affixes, 1.0), Mul(BossHp, 0.7),
        Mul(Healing, -0.25), Rule(BossExtra),
        Mul(OilGain, 0.5), Mul(GoldGain, 0.5),
    ]),
]
