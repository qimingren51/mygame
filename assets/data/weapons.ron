            flavor: "斗柄绕着北极转，剑气绕着你转。",
            // 一整圈；暴击的那一下对同一只再斩一次（× 1.0，再斩不再触发）
            behavior: Sweep(arc: 6.2832, aim: 40.0, knockback: 25.0, crit_bonus: 0.15, echo: 1.0),
