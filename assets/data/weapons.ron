            (count: 1, damage: 16.0),
            (count: 2, damage: 20.0),
            (count: 2, damage: 24.0),
            (count: 3, damage: 28.0),
            (count: 3, damage: 32.0),
            (count: 4, damage: 36.0),
            (count: 4, damage: 40.0),
            (count: 5, damage: 44.0),
        ],
        evolution: Some((
            name: "千鹤引", passive: "zhezhi",
            desc: "十只纸鹤随身，扑击更快更狠。", short: "十只纸鹤，更快更狠",
            flavor: "鹤多了，就成了一条引魂的路。",
            behavior: Seeker(orbit_radius: 34.0, orbit_spin: 2.0, range: 340.0, pick: 3, rest: 0.2,
                             knockback: 50.0, speed: (330.0, 0.0, 0.0), steer: 7.0, reach: 6.0),
            level: (count: 10, damage: 49.5),
        )),
        mutation: Some((
            name: "铁鹤", desc: "鹤群收为五只铁鹤，单次伤害三倍，扑击射出穿透铁羽；斩杀两成血以下小妖。数量加成失效，不能合璧。", short: "五只铁鹤，伤害 ×3",
            flavor: "纸鹤让金气浸透，成了铁的。少了，可每一只都要命。",
            // 铁羽：穿透 5、速度 480、存活 0.6 秒，伤害为扑击的 30%（全额会远超进化的伤害预算）
            behavior: Seeker(orbit_radius: 34.0, orbit_spin: 2.0, range: 360.0, pick: 3, rest: 0.5,
                knockback: 25.0, speed: (350.0, 0.0, 0.0), steer: 7.0, reach: 8.0,
                feather: Some((pierce: 5, speed: 480.0, life: 0.6, ratio: 0.3)), execute: 0.2, count_cap: Some(5)),
            level: (count: 5, damage: 148.5),
        )),
    ),
    (
        id: "seal", name: "山印", icon: "印", element: Earth,
        desc: "石印从天而降，范围伤害并击晕。", short: "石印落地，击晕一片",
        flavor: "盖下去的是一座山。印下的妖，一时站不起来。",
        // 从 300 内最近 12 只里随机选落点（不足时在主角周围随机），预警 0.45 秒、依次间隔 0.12 秒；
        // 落地击退 90、击晕 0.5 秒
        behavior: Drop(range: 300.0, candidates: 12, delay: 0.45, stagger: 0.12, knockback: 90.0,
                       stun: 0.5, scatter: (150.0, 100.0), amount_div: 2),
        levels: [
