        )),
    ),
    (
        id: "sky_lantern", name: "孔明灯", icon: "孔", element: Fire,
        desc: "放飞孔明灯，飘向妖物最密的地方，落地爆燃，留下火海。", short: "灯飘向妖群，落地爆燃",
        flavor: "狐村的孩子还你的。它往妖最多的地方飘，再落下来。",
        // 落点：360 以内最近的 24 只里，挑 100 以内同伴最多的那只；几盏至少隔开 120。灯每秒飘 60，3 秒后落地。
        // 火海：半径 0.8 倍，3 秒，每 0.5 秒伤害 × 0.12
