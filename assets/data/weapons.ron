            (cooldown: 2.66, count: 3, radius: 66.0, damage: 78.0),
            (cooldown: 2.44, count: 3, radius: 70.0, damage: 86.0),
        ],
        evolution: Some((
            name: "镇岳", passive: "houde",
            desc: "巨岩砸出地裂，裂缝持续伤害并减速。", short: "巨岩砸地，裂缝伤敌",
            flavor: "印里的山长成了岳，砸下来，地都裂开。",
            // 地裂：半径 ×0.85、持续 2.5 秒、每 0.5 秒造成落地伤害的 25%、减速 40%
            behavior: Drop(range: 300.0, candidates: 12, delay: 0.45, stagger: 0.12, knockback: 90.0,
                           stun: 0.5, scatter: (150.0, 100.0), amount_div: 2,
