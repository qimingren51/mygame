                                          slow: 0.4, slow_time: 0.6))),
            // 范围是满级的 1.6 倍（原型 2 倍）
            level: (cooldown: 2.6, count: 4, radius: 112.0, damage: 129.0),
        )),
        mutation: Some((
            name: "竹印", desc: "巨竹破土挑飞妖物，留存四秒阻挡追兵。舍弃地裂持续伤害与合璧，借竹墙绕出活路。", short: "巨竹挑飞，竹墙挡路",
            flavor: "石印没落下来，地下冲出一根竹子。青丘的竹，顶得起山。",
            // 竹墙：不造成伤害，普通妖物穿过时移速 ×0.12（和地图竹丛取更慢的一个），夜主、精英不受阻
