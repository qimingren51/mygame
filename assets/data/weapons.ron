                stun: 1.2, scatter: (150.0, 100.0), amount_div: 2,
                fissure: Some((kind: Bamboo, radius_scale: 0.5, life: 4.0, tick: 0.5,
                    damage_scale: 0.0, slow: 0.0, slow_time: 0.0, wall: Some(0.12)))),
            level: (cooldown: 2.9, count: 3, radius: 90.0, damage: 120.0),
        )),
    ),
    // v0.3 的五件新法器（docs/BALANCE.md 第 6.3 节），每个五行两件。
    (
        id: "coin_sword", name: "铜钱剑", icon: "钱", element: Metal,
        desc: "朝最近的妖物挥出扇形剑气，自带暴击。", short: "扇形剑气，自带暴击",
        flavor: "七枚铜钱排成北斗。挥一下，斩一片。",
        // 120° 扇形；方向朝 radius + 40 以内最近的妖物，没有就朝面向；扇形里从近到远最多打 count 只；暴击率 +15%
