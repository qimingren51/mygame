// 法器（移植自网页版 data/weapons.ts 与 sim/weapons.ts）。最多 6 件，levels 从第 1 级到满级（8 级）。
// 进化：满级并持有 evolution.passive 心法后，下次升级必出；进化后换成 evolution 里的行为参数和数值。
// “数量”都再加属性 Amount（山印只加 Amount / amount_div）；冷却乘以 Cooldown，范围乘以 Area。
[
    (
        id: "lamp", name: "灯火", icon: "灯", element: Fire,
        desc: "火焰环绕周身，烧灼靠近的妖物。", short: "火环绕身，烧近身妖",
        flavor: "长明火自己的火。它绕着你转，夜挨不近你。",
        // 转速 3.2 + 0.12·等级（弧度/秒）；同一只妖物 0.45 秒内只吃一次；火焰判定半径 10
        behavior: Orbit(spin: (3.2, 0.12, 0.0), hit_cooldown: 0.45, knockback: 50.0, size: 10.0),
        levels: [
            (count: 3, radius: 54.0, damage: 10.9),
            (count: 3, radius: 58.0, damage: 13.0),
            (count: 4, radius: 62.0, damage: 15.1),
            (count: 4, radius: 66.0, damage: 17.3),
            (count: 5, radius: 70.0, damage: 19.5),
            (count: 5, radius: 74.0, damage: 21.7),
            (count: 6, radius: 78.0, damage: 23.9),
            (count: 6, radius: 82.0, damage: 26.0),
        ],
        evolution: Some((
            name: "不夜城", passive: "changming",
            desc: "十盏灯笼环城而行，内圈多一层火海。", short: "十盏灯环身，内圈火海",
            flavor: "东莱有不夜县，夜里出过太阳。十盏灯一围，这里也是。",
            // 外圈伤害是满级的 2 倍；内环火海半径 50，每 0.5 秒造成外圈伤害的 20%（docs/BALANCE.md 第 6.1 节）
            behavior: Orbit(spin: (2.4, 0.0, 0.0), hit_cooldown: 0.45, knockback: 50.0, size: 12.0,
                            inner: Some((radius: 50.0, every: 0.5, ratio: 0.2))),
            level: (count: 10, radius: 92.0, damage: 52.0),
        )),
        mutation: Some((
            name: "冰火两重天", desc: "五盏冰焰冻结、五盏火焰灼烧。绕行让同一只妖先后触两焰，引爆蒸腾；舍弃内环火海与合璧。", short: "半冰半火，引爆蒸腾",
            flavor: "十盏灯，一半的焰是冷的。冷热一撞，就是一团白汽。",
            // 冰焰冻结 0.6 秒，火焰点 1 层灼烧；固定十盏，不吃数量加成
            behavior: Orbit(spin: (2.4, 0.0, 0.0), hit_cooldown: 0.38, knockback: 35.0, size: 12.0,
                            ice_fire: Some((freeze: 0.6, ignite: 1.0))),
            level: (count: 10, radius: 92.0, damage: 39.0),
        )),
    ),
    (
        id: "sword", name: "符剑", icon: "剑", element: Metal,
        desc: "自动射出追踪符剑，可穿透。", short: "追踪飞剑，可穿透",
        flavor: "剑身贴着符，认得妖气，自己会找过去。",
        // 朝 460 内最近的妖物齐射，扇形间隔 0.14 弧度；飞剑速度 380、存活 1.5 秒、追踪转向 8 弧度/秒
        behavior: Volley(range: 460.0, speed: 380.0, life: 1.5, turn: 8.0, hit_radius: 6.0,
                         knockback: 30.0, spread: 0.14, retry: 0.2),
        levels: [
            (cooldown: 1.09, count: 1, damage: 19.0, pierce: 1),
            (cooldown: 1.03, count: 1, damage: 24.0, pierce: 1),
            (cooldown: 0.97, count: 2, damage: 29.0, pierce: 2),
            (cooldown: 0.91, count: 2, damage: 34.0, pierce: 2),
            (cooldown: 0.85, count: 2, damage: 38.0, pierce: 2),
            (cooldown: 0.79, count: 3, damage: 43.0, pierce: 3),
            (cooldown: 0.73, count: 3, damage: 48.0, pierce: 3),
            (cooldown: 0.67, count: 3, damage: 53.0, pierce: 3),
        ],
        evolution: Some((
            name: "万剑归宗", passive: "jianyi",
            desc: "飞剑连发，无限穿透。", short: "三剑连发，无限穿透",
            flavor: "万剑同出一宗。一剑过去，后面的都跟上。",
            behavior: Volley(range: 460.0, speed: 380.0, life: 1.5, turn: 8.0, hit_radius: 9.0,
                             knockback: 30.0, spread: 0.14, retry: 0.2),
            level: (cooldown: 0.42, count: 3, damage: 84.5, pierce: 999),
        )),
        mutation: Some((
            name: "赤霄", desc: "赤剑命中熔金易伤，击杀分作两剑，分剑不再分裂。舍弃无限穿透与合璧，追逐残血妖群。", short: "熔金易伤，击杀分剑",
            flavor: "汉高祖斩白蛇的剑叫赤霄。符剑在火里烧红了，也就成了它。",
            // 熔金：易伤 30%、4 秒；击杀时朝 460 内最近的两只各分一剑，伤害为这一击的 60%
            behavior: Volley(range: 460.0, speed: 400.0, life: 1.5, turn: 8.0, hit_radius: 9.0,
                knockback: 25.0, spread: 0.14, retry: 0.2,
                molten: Some((vulnerability: 0.3, duration: 4.0,
                    split: Some((count: 2, ratio: 0.6, range: 460.0, speed: 420.0, life: 1.0, turn: 8.0,
                        hit_radius: 7.0, knockback: 15.0))))),
            level: (cooldown: 0.42, count: 3, damage: 80.0, pierce: 5),
        )),
    ),
    (
        id: "bell", name: "霜铃", icon: "铃", element: Water,
        desc: "周期震出寒波，伤害并减速周围妖物。", short: "寒波伤敌并减速",
        flavor: "檐下的铃，夜里摇出霜来。",
        // 寒波击退 40，减速 35% 持续 1.5 秒
        behavior: Pulse(knockback: 40.0, slow: 0.35, slow_time: 1.5),
        levels: [
            (cooldown: 1.99, radius: 79.0, damage: 14.0),
            (cooldown: 1.89, radius: 88.0, damage: 18.0),
            (cooldown: 1.78, radius: 97.0, damage: 23.0),
            (cooldown: 1.68, radius: 106.0, damage: 26.0),
            (cooldown: 1.57, radius: 115.0, damage: 31.0),
            (cooldown: 1.47, radius: 124.0, damage: 36.0),
            (cooldown: 1.36, radius: 133.0, damage: 40.0),
            (cooldown: 1.26, radius: 142.0, damage: 45.0),
        ],
        evolution: Some((
            name: "寒山钟", passive: "jingxin",
            desc: "每 6 秒钟鸣全屏，冻结所有妖物。", short: "每 6 秒全屏冻结",
            flavor: "夜半钟声到客船。钟一响，什么都停了。",
            // 每 6 秒（乘以冷却）全屏钟鸣：冻结 1.5 秒（夜主除外）、伤害 90（对夜主单次封顶 400）
            behavior: Pulse(knockback: 40.0, slow: 0.35, slow_time: 1.5,
                            toll: Some((period: 6.0, damage: 105.0, freeze: 1.5, boss_cap: 400.0))),
            level: (cooldown: 1.26, radius: 184.6, damage: 67.0),
        )),
        mutation: Some((
            name: "冻土", desc: "脚下冻土常驻，圈内持续减速，小妖死于圈内便碎裂伤敌，碎裂不连锁。舍弃全屏钟鸣与合璧，守住近身阵地。", short: "脚下冻土，冻死即碎",
            flavor: "铃声渗进地里，脚下的土冻住了，再也化不开。",
            // 碎裂：半径 65、伤害为冻土的 1.5 倍，每步至多 8 次
            behavior: Pulse(knockback: 0.0, slow: 0.6, slow_time: 0.65,
                permafrost: Some((shatter_radius: 65.0, shatter_ratio: 1.5, shatter_budget: 8))),
            level: (cooldown: 0.5, radius: 125.0, damage: 18.0),
        )),
    ),
    (
        id: "crane", name: "纸鹤", icon: "鹤", element: Wood,
        desc: "纸鹤自动扑向妖物，撞击后折返。", short: "纸鹤自动扑击",
        flavor: "纸扎的鹤，本是送亡魂上路的。现在它替你去找妖。",
        // 平时绕身（半径 34）；随机扑向 340 内最近 3 只之一，撞到即伤害，休息 0.35 秒；速度 250 + 6·等级
        behavior: Seeker(orbit_radius: 34.0, orbit_spin: 2.0, range: 340.0, pick: 3, rest: 0.35,
